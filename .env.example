# Copy to .env and replace every placeholder before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-value
MYSQL_DATABASE=dental
MYSQL_USER=dental
MYSQL_PASSWORD=replace-with-a-different-long-random-value
DATABASE_URL=mysql://dental:replace-with-a-different-long-random-value@mysql:3306/dental
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-48-output
ML_SERVICE_URL=http://ml-service:8001
ML_API_KEY=replace-with-a-long-random-value
ML_CPU_THREADS=2
CHAT_MODEL_REVISION=9599cc64f7e7e14ddd639023f386f4623878e0d8
ALLOWED_ORIGINS=https://your-domain.example
PRIVATE_UPLOAD_DIR=/data/uploads
RUN_DB_MIGRATIONS=false
SEED_DEFAULT_ADMIN=false
