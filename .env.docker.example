# Optional local overrides for `docker compose`. Copy to `.env` and replace these
# development-only values if desired. Never use these sample values in production.
MYSQL_ROOT_PASSWORD=dental-local-root-password
MYSQL_DATABASE=dental
MYSQL_USER=dental
MYSQL_PASSWORD=dental-local-password
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dental-local-nextauth-secret-change-for-deployment
ML_API_KEY=dental-local-ml-key
ALLOWED_ORIGINS=
GEMINI_API_KEY=
RUN_DB_MIGRATIONS=true
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@gmai.com
DEFAULT_ADMIN_PASSWORD=admin
